SESSION_JWT_SECRET=replace-with-a-32-byte-random-string
SESSION_COOKIE_NAME=mchverse_session

# --- MCH Verse target chain (testnet by default) ---
# Testnet (Sandbox, permissionless):
#   id=420, RPC=https://rpc.oasys.sand.mchdfgh.xyz, Explorer=https://explorer.oasys.sand.mchdfgh.xyz
# Mainnet (allowlist required for deploys):
#   id=29548, RPC=https://rpc.oasys.mycryptoheroes.net, Explorer=https://explorer.oasys.mycryptoheroes.net
NEXT_PUBLIC_CHAIN_ID=420
NEXT_PUBLIC_RPC_URL=https://rpc.oasys.sand.mchdfgh.xyz
NEXT_PUBLIC_EXPLORER_BASE=https://explorer.oasys.sand.mchdfgh.xyz

# MCHC ERC-20 address. Mainnet: 0x9e5AAC1Ba1a2e6aEd6b32689DFcF62A509Ca96f3
# Testnet: ask MCH support (or leave the mainnet default until confirmed).
NEXT_PUBLIC_MCHC_ADDRESS=

# Get a free Project ID from https://cloud.reown.com/ (WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# MUD World address. Filled in after `pnpm deploy:testnet` in contracts/.
# The address is also written to contracts/worlds.json by MUD.
NEXT_PUBLIC_WORLD_ADDRESS=
